# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Project data (never commit raw medical images). Ignore contents, not the
# directory itself — git.gitignore skips excluded dirs entirely, so `data/raw/`
# alone (with no matching content pattern) would leave a fresh clone without
# the directory at all.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Optional baked model for the API Docker image
serving_model/*
!serving_model/.gitkeep

# MLflow local tracking store
mlflow.db
mlartifacts/
mlflow-seed/

# Lightning checkpoints (default_root_dir "1/<run_id>/checkpoints/") — named
# explicitly, not just via *.ckpt below, so any future non-.ckpt file Lightning
# drops there (hparams.yaml, metrics.csv) doesn't slip through.
1/

# Node / frontend
node_modules/
frontend/dist/

# Kaggle credentials
kaggle.json
.kaggle/

# Local environment / secrets — never commit
.env

# Model checkpoints (stored in MLflow instead)
*.ckpt
*.pth
*.pt

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Hydra outputs
outputs/
multirun/
.hydra/

# Logs (keep directory; ignore captured train/eval output)
logs/*
!logs/.gitkeep
*.log

# Coverage
.coverage
htmlcov/
.pytest_cache/

# MyPy
.mypy_cache/
