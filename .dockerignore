dist
build
*.egg-info

# Data — never bake into images
data/raw
data/processed
outputs
multirun
.hydra

# Local tracking / checkpoints (models are always loaded from MLflow at
# runtime, never baked into the image). Patterns here are root-anchored —
# "*.ckpt" alone does not match "1/<run>/checkpoints/*.ckpt", so the nested
# checkpoint tree needs its own entry and a "**/" glob.
mlflow.db
mlartifacts
mlflow-seed
1/
logs
**/mlruns
**/*.ckpt
**/*.pth
**/*.pt

# Frontend build artifacts (frontend image has its own context)
frontend/node_modules
frontend/dist

# Notebooks / IDE / docs noise
notebooks
.vscode
.idea
*.md
!README.md
LICENSE
.env
kaggle.json
.kaggle

# Tests not needed at runtime
tests
