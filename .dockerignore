# Local tracking / checkpoints (use volume or serving_model instead). Patterns here
# are root-anchored — "*.ckpt" alone does not match "1/<run>/checkpoints/*.ckpt",
# so the nested checkpoint tree needs its own entry and a "**/" glob.
mlflow.db
mlartifacts
mlflow-seed
1/
logs
**/mlruns
**/*.ckpt
**/*.pth
**/*.pt

# Frontend build artifacts (frontend image has its own context)
frontend/node_modules
frontend/dist

